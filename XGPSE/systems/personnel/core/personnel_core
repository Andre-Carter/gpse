#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn list_rejects_duplicates() {
        let mut list = PersonnelList::new();
        assert!(list.add(Personnel::new(PersonnelId(1))));
        assert!(!list.add(Personnel::new(PersonnelId(1))));
        assert_eq!(list.len(), 1);
    }

    #[test]
    fn records_lookup_by_id() {
        let mut records = PersonnelRecords::new();
        records.add(PersonnelRecord::new(PersonnelId(556), PersonnelName::new("Doe")));
        assert!(records.get(PersonnelId(556)).is_some());
        assert!(records.get(PersonnelId(223)).is_none());
    }
}